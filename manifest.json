{
  "manifest_version": 3,
  "name": "Veil — Blur Before You Share",
  "version": "1.3.0",
  "description": "Hide names, numbers, or any part of a page — then screenshot, record, or present with it redacted. Nothing leaves your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "downloads", "tabCapture", "offscreen", "storage"],
  "commands": {
    "activate-blur-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle Blur & Screenshot mode"
    }
  }
}
